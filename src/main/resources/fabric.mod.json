{
  "schemaVersion": 1,
  "id": "damoko-addon",
  "version": "${version}",
  "name": "Damoko Add On",
  "description": "Damoko's addon for AUTISM Client.",
  "authors": [
    "Damoko"
  ],
  "custom": {
    "autism:color": "255,80,80",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.addon.ExampleInit"
    ],
    "autism": [
      "com.example.addon.ExampleAddon"
    ]
  },
  "mixins": [
    "autism-advanced-addon-template.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "autism": ">=${autism_api_version}"
  }
}
